{
  "name": "turnwise-packages",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=22.18"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "license:verify": "license-wizard --verify --strict",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm license:verify"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-dotignore": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "license-wizard": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
