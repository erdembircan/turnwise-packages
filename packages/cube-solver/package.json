{
  "name": "@turnwise/cube-solver",
  "version": "0.0.0",
  "description": "Typed 3×3 Rubik's Cube solver using Kociemba's two-phase algorithm.",
  "keywords": ["rubiks-cube", "3x3", "cube", "solver", "kociemba", "two-phase", "speedcubing", "typescript"],
  "license": "Apache-2.0",
  "author": "Erdem Bircan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erdembircan/turnwise-packages.git",
    "directory": "packages/cube-solver"
  },
  "homepage": "https://github.com/erdembircan/turnwise-packages/tree/main/packages/cube-solver#readme",
  "bugs": "https://github.com/erdembircan/turnwise-packages/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -b",
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm LICENSE",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
